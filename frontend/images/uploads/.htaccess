# Uploads folder: serve images, but never execute anything inside.
<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
AddType text/plain .php .phtml .phar
